@{
    ViewData["Title"] = "Solicitud de Cuenta";
    Layout = null;
}

<link rel="stylesheet" href="~/css/solicitudCuenta.css" />

<div class="solicitud-container">
    <div class="solicitud-card">
        <h2>Solicitud de Creación de Cuenta</h2>
        <p>Completa los siguientes datos para solicitar una cuenta. Te contactaremos pronto.</p>

        <form asp-action="EnviarSolicitud" asp-controller="Auth" method="post" class="solicitud-form">
            <div class="input-group">
                <label for="nombre">Nombre completo</label>
                <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre completo" />
            </div>

            <div class="input-group">
                <label for="correo">Correo electrónico</label>
                <input type="email" id="correo" name="correo" required placeholder="Tu correo electrónico" />
            </div>

            <div class="input-group">
                <label for="mensaje">Mensaje o motivo</label>
                <textarea id="mensaje" name="mensaje" rows="4" required placeholder="Explica tu solicitud"></textarea>
            </div>

            <button type="submit" class="btn-enviar">Enviar solicitud</button>
        </form>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alerta">@ViewBag.Mensaje</div>
        }

        <a asp-controller="Auth" asp-action="Login" class="volver">← Volver al inicio de sesión</a>
    </div>
</div>


