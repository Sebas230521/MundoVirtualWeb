@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inicio de Sesión - Virtual Salud ERP</title>
    <!--Favicon de pestaña-->
    <link rel="icon" href="~/favicon/logo_mundovirtual.png">
    <!-- Bootstrap CSS -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Estilos personalizados -->
    <link href="~/css/login.css" rel="stylesheet" />
</head>
<body class="bg-light">

    <!-- Contenedor principal -->
    <div class="container d-flex align-items-center justify-content-center min-vh-100">
        <div class="card shadow-lg p-4 rounded-4" style="max-width: 420px; width: 100%; border: none;">

            <!-- Logo -->
            <div class="text-center mb-3">
                <img src="~/images/logo_virtualsalud.png" alt="Virtual Salud ERP" width="120" class="mb-3" />
                <h4 class="fw-bold text-dark">Virtual Salud ERP</h4>
                <p class="text-muted">Inicie sesión para Continuar</p>
            </div>

            <!-- Mensaje de error -->
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center py-2">
                    @ViewBag.Error
                </div>
            }

            <!-- Formulario de login -->
            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label for="usuario" class="form-label fw-semibold">Usuario</label>
                    <input type="text" id="usuario" name="usuario" class="form-control" placeholder="Ingrese su usuario" required />
                </div>

                <div class="mb-4">
                    <label for="contrasena" class="form-label fw-semibold">Contraseña</label>
                    <input type="password" id="contrasena" name="contrasena" class="form-control" placeholder="Ingrese su contraseña" required />
                </div>

                <button type="submit" class="btn w-100 fw-semibold text-white" style="background: linear-gradient(135deg, #00B96E, #2EFF88);">
                    Iniciar sesión
                </button>

                <div class="text-center mt-3">
                    <!--<a href="~/Cuenta/Registro" class="text-decoration-none fw-semibold" style="color: #00B96E;">
                        ¿No tienes cuenta? Solicitala aquí.
                    </a>-->
                    <p class="text-center">
                        ¿No tienes cuenta? <a asp-controller="Auth" asp-action="SolicitudCuenta">Solicita una aquí</a>
                    </p>

                </div>

            </form>

            <!-- Footer -->
            <div class="text-center mt-4">
                <small class="text-muted">
                    © @DateTime.Now.Year Virtual Salud ERP<br />
                    Todos los derechos reservados.
                </small>
            </div>

        </div>
    </div>
    <!-- Loader -->
    <div id="loader" class="loader-overlay d-none">
        <div class="spinner-border text-light" role="status" style="width: 4rem; height: 4rem;">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>

    <!--Enlace Bootstrap-->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!--Animacion de carga-->
    <script>
        const form = document.querySelector('form');
        const loader = document.getElementById('loader');

        form.addEventListener('submit', () => {
            loader.classList.remove('d-none');
        });
    </script>


</body>
</html>


