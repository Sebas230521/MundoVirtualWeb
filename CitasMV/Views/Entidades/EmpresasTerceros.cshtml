@{
    ViewData["Title"] = "Empresas Terceros";
}
<link rel="stylesheet" href="~/css/empresasTerceros.css" />
<div class="container mt-4 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header text-center text-white bg-gradient-success rounded-top-4">
            <h4 class="m-0">GESTIÓN DE LAS ADMINISTRADORAS DE PLANES</h4>
        </div>

        <div class="card-body p-4">
            <!-- Encabezado -->
            <div class="row mb-4">
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Código</label>
                    <input type="text" class="form-control" />
                </div>

                <div class="col-md-5">
                    <label class="form-label fw-semibold">Nombre de la administradora de planes</label>
                    <input type="text" class="form-control" />
                </div>

                <!-- Ajusté a col-md-2 (antes 1) y cerré el select -->
                <div class="col-md-2">
                    <label for="tipoDocumento" class="form-label fw-semibold">Tipo Documento</label>
                    <select id="tipoDocumento" name="TipoDocumento" class="form-select" required>
                        <option value="">Seleccione...</option>
                        <option>CC</option>
                        <option>CE</option>
                        <option>NIT</option>
                        <option>RUT</option>
                        <option>PAS</option>
                    </select>
                </div>

                <!-- Ajusté a col-md-2 (antes 3) -->
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Documento No.</label>
                    <input type="text" class="form-control" />
                </div>

                <!-- Ajusté a col-md-1 (antes 2) para sumar 12 -->
                <div class="col-md-1">
                    <label class="form-label fw-semibold">DV</label>
                    <input type="text" class="form-control" />
                </div>

            <!-- Fila 1 -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Convenio</label>
                    <input type="text" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Tipo adminis.</label>
                    <select class="form-select">
                        <option>OTR</option>
                        <option>EPS</option>
                        <option>ARL</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">SGSSS (Codigo Entidad)</label>
                    <input type="text" class="form-control" />
                </div>
            </div>

            <!-- Fila 2 -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Plan</label>
                    <input type="text" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">M. Tarifario</label>
                    <select class="form-select">
                        <option>CUPS</option>
                        <option>IPS</option>
                        <option>ISS</option>
                        <option>SOAT</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Tarifas</label>
                    <select class="form-select">
                        <option>SOAT</option>
                        <option>CUPS</option>
                    </select>
                </div>
            </div>

            <!-- Fila 3 -->
            <div class="row mb-3">
                <div class="col-md-3">
                        <label class="form-label fw-semibold">Regimen</label> <!--Conectar con BD-->
                        <select class="form-select">
                            <option>PARTICULAR</option>
                            <option>CONTRIBUTIVO</option>
                        </select>
                </div>
                <div class="col-md-3">
                        <label class="form-label fw-semibold">Jurídica</label> <!--Conectar con BD-->
                        <select class="form-select">
                            <option>Públicas</option>
                            <option>Privadas</option>
                            <option>Otras</option>
                        </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Contable</label>
                    <input type="text" class="form-control" placeholder="00000000" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Nivel 1</label>
                    <input type="number" class="form-control" />
                </div>
            </div>

            <!-- Fila 4 -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Contacto</label>
                    <input type="text" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">¿Habilitada?</label>
                    <select class="form-select">
                        <option value="">Seleccione...</option>
                        <option>Sí</option>
                        <option>No</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Nivel 2</label>
                    <input type="number" class="form-control" />
                </div>              
            </div>

            <!-- Fila 5 -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Dirección</label>
                    <input type="text" class="form-control" placeholder="Calle 123 #45-67" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Copago</label>
                    <select class="form-select">
                        <option>Sí</option>
                        <option>No</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Nivel 3</label>
                    <input type="number" class="form-control" />
                </div> 
            </div>

            <!-- Fila 6 -->
            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Teléfonos</label>
                    <input type="text" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Fax</label>
                    <input type="text" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Actividades</label>
                    <select class="form-select">
                        <option>Promoción y prevención</option>
                        <option>Atención médica</option>
                    </select>
                </div>
            </div>

            <!-- Fila 7 -->
            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Celular</label>
                    <input type="text" class="form-control" />
                </div>
                <div class="col-md-4 d-flex align-items-center">
                    <label class="form-label fw-semibold me-2 mb-0">No. de días de vencimiento de admisiones:</label>
                    <input type="number" class="form-control w-25" value="0" />
                </div>
                <div class="col-md-4 d-flex align-items-center">
                    <label class="form-label fw-semibold me-2 mb-0">No. días vencimiento de facturas:</label>
                    <input type="number" class="form-control w-25" value="0" />
                </div>
            </div>

            <!-- Fila 8 -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Departamento</label>
                    <select id="Departamento" name="DptoId" class="form-select" required>
                        <option value="">Seleccione un Departamento</option>
                        @foreach (dynamic departamento in ViewBag.Departamentos)
                        {
                            <option value="@departamento.CodigoDpto">@departamento.NombreDpto</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Fila 9 -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Ciudad/Pueblo</label>
                    <select id="Ciudad" name="CiudadId" class="form-select" required>
                        <option value="">Seleccione una ciudad</option>
                    </select>
                </div>
            </div>
            <!-- Facturación Electrónica -->
            <div class="section-title text-success mt-4 mb-2 fw-semibold">
                Facturación Electrónica
            </div>
            <!-- Fila 1 -->
            <div class="row mb-3">
                <div class="col-md-6 d-flex align-items-center">
                    <label class="fw-semibold mb-0 me-2">Tipo Organización:</label>
                    <select class="form-select w-auto flex-grow-1">
                        <option>Jurídica</option>
                        <option>Natural</option>
                    </select>
                </div>

                <div class="col-md-6 d-flex align-items-center">
                    <label class="fw-semibold mb-0 me-2">Régimen Fiscal:</label>
                    <select class="form-select w-auto flex-grow-1">
                        <option>IMPOVENTAS - IVA</option>
                        <option>NO RESPONSABLE IVA</option>
                    </select>
                </div>
            </div>

            <!--Fila 2-->
            <div class="row mb-3">
                <div class="col-md-6 d-flex align-items-center">
                    <label class="fw-semibold mb-0 me-2">Responsabilidad Fiscal</label> <!--Coencatr a la BD-->
                    <select class="form-select w-auto flex-grow-1">
                        <option>No Responsable</option>
                        <option>Responsable</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-center">
                    <label class="form-label fw-semibold me-2 mb-0">Matricula Mercantil</label>
                    <input type="number" class="form-control w-25" value="0" />
                </div>
            </div>

            <!--Fila 3-->  
            <div class="row mb-3">
                <div class="col-md-12">
                    <label class="form-label fw-semibold">Correo Electronico</label>
                    <input type="text" class="form-control" placeholder="Ejemplo: correovaaca@gmail.com" />
                </div>
            </div>

            <!--Fila4-->
            <div class="row mb-3">
                <div class="col-md-6 d-flex align-items-center">
                    <label class="fw-semibold mb-0 me-2">Tipo Contratación</label> <!--Coencatr a la BD-->
                    <select class="form-select w-auto flex-grow-1">
                        <option>Pago por evento</option>
                        <option>Pago por capitación</option>
                    </select>
                </div>

                <div class="col-md-6 d-flex align-items-center">
                    <label class="fw-semibold mb-0 me-2">Plan de Beneficios</label> <!--Coencatr a la BD-->
                    <select class="form-select w-auto flex-grow-1">
                        <option>Particular</option>
                        <option>Cobertura ARL</option>
                    </select>
                </div>
            </div>

            <!--Quien Registra-->
            <div class="section-title text-success mt-4 mb-2 fw-semibold">
                Información de registro
            </div>
            <!-- Auditoría -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Registrada por</label>
                    <input type="text" class="form-control" value="JHONIER STIVEN GUTIERREZ QUINTERO" />
                </div>
                <div class="col-md-1">
                    <label class="form-label fw-semibold">ID</label>
                    <input type="text" class="form-control" value="274" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Día Que fue registrado</label>
                    <input type="date" class="form-control" value="2020-09-15" />
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Modificada por</label>
                    <input type="text" class="form-control" value="OSCAR ROMAN ANGEL FERREIRA" />
                </div>
                <div class="col-md-1">
                    <label class="form-label fw-semibold">ID</label>
                    <input type="text" class="form-control" value="274" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Día que fue Modificado</label>
                    <input type="date" class="form-control" value="2023-08-02" />
                </div>
            </div>

            <!-- Botones -->
            <div class="text-center mt-4">
                <button class="btn btn-success mx-1">Nuevo</button>
                <button class="btn btn-primary mx-1">Modificar</button>
                <button class="btn btn-danger mx-1">Eliminar</button>
                <button class="btn btn-success mx-1">Guardar</button>
            </div>    
            <div class="text-center mt-4">
                <button class="btn btn-secondary mx-1">Anterior</button>
                <button class="btn btn-warning mx-1">Buscar</button>
                <button class="btn btn-secondary mx-1">Siguiente</button>
                <button class="btn btn-dark mx-1">Salir</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById("Departamento").addEventListener("change", function () {

        let dpto = this.value;
        let ciudadSelect = document.getElementById("Ciudad");

        ciudadSelect.innerHTML = '<option value="">Cargando...</option>';

        if (dpto === "") {
            ciudadSelect.innerHTML = '<option value="">Seleccione una ciudad</option>';
            return;
        }

        fetch(`/Entidades/ObtenerCiudadesPorDepartamento?codigoDpto=${dpto}`)
            .then(resp => resp.json())
            .then(data => {

                ciudadSelect.innerHTML = '<option value="">Seleccione una ciudad</option>';

                data.forEach(c => {
                    ciudadSelect.innerHTML += 
                        `<option value="${c.conseCodigo}">${c.nombreCiudad}</option>`;
                });
            })
            .catch(err => {
                ciudadSelect.innerHTML = '<option value="">Error al cargar ciudades</option>';
                console.error("Error al cargar ciudades:", err);
            });
    });
</script>

