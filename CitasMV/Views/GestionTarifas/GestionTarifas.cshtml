@{
    ViewData["Title"] = "Gestion Tarifas";
}
<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <h4 class="mb-0">GESTIÓN DE TARIFAS</h4>
        </div>

        <div class="card-body">

            <!-- FILA 1 -->
            <div class="row mb-3">
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Código</label>
                    <input type="text" class="form-control" name="Codigo">
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Nombre</label>
                    <input type="text" class="form-control" name="Nombre">
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Descripción</label>
                    <input type="text" class="form-control" name="Descripcion">
                </div>
            </div>

            <!-- FILA 2 -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Manual Tarifario</label>
                    <select class="form-select" name="ManualTarifario">
                        <option value="">Seleccione...</option>
                        <option value="SOAT">SOAT</option>
                        <option value="POS">POS</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Signo</label>
                    <select class="form-select" name="Signo">
                        <option value="">Seleccione...</option>
                        <option value="+">+</option>
                        <option value="-">-</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Porcentaje</label>
                    <input type="number" class="form-control" name="Porcentaje">
                </div>
            </div>

            <!-- FILA 3 -->
            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Registrado por</label>
                    <input type="text" class="form-control" name="RegistradoPor">
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Fecha Registro</label>
                    <input type="date" class="form-control" name="FechaRegistro">
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Modificado por</label>
                    <input type="text" class="form-control" name="ModificadoPor">
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Fecha Modificación</label>
                    <input type="date" class="form-control" name="FechaModificacion">
                </div>
            </div>

            <hr />

            <!-- BOTONES -->
            <div class="d-flex justify-content-between flex-wrap gap-2">
                <button class="btn btn-primary px-4">Nuevo</button>
                <button class="btn btn-secondary px-4">Modificar</button>
                <button class="btn btn-success px-4">Guardar</button>
                <button class="btn btn-danger px-4">Eliminar</button>
                <button class="btn btn-outline-primary px-4">Anterior</button>
                <button class="btn btn-outline-primary px-4">Siguiente</button>
                <button class="btn btn-dark px-4">Salir</button>
            </div>

            <div class="mt-3 text-end text-muted fw-semibold">
                <span>ID: 001</span>
            </div>

        </div>
    </div>
</div>
